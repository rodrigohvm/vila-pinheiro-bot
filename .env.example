# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA compartilhe o arquivo .env com ninguém nem suba ele pro GitHub.

# Chave da API da Anthropic (Claude) - pegue em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo da Claude a ser usado (Haiku é rápido e barato, ótimo para FAQ)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- WhatsApp Cloud API (Meta) ---
# Token de acesso permanente do seu app no Meta for Developers
WHATSAPP_TOKEN=
# ID do número de telefone (Phone Number ID) dentro do WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
# Token que você mesmo inventa (uma senha qualquer) para validar o webhook com a Meta
WHATSAPP_VERIFY_TOKEN=escolha-uma-senha-aqui

# --- Instagram Messaging API (Meta) ---
# Token de acesso da Página do Facebook conectada ao seu Instagram profissional
INSTAGRAM_PAGE_TOKEN=
# Mesmo verify token pode ser reaproveitado aqui
INSTAGRAM_VERIFY_TOKEN=escolha-uma-senha-aqui

# Chave simples para você acessar o painel de "escalonamentos" (avisos de que um cliente quer reservar)
ADMIN_KEY=escolha-outra-senha-aqui

# Porta do servidor (Railway/Render definem isso automaticamente, pode deixar como está)
PORT=3000
